  "nouveautes": [
    {
      "version": 7,
      "texte": "Nouvelle organisation en 3 onglets : Aujourd'hui (une seule chose utile à la fois), Nuit et Progrès. Fais ton point de départ (2 minutes) pour voir si ça va mieux, et pense à sauvegarder tes données (Réglages, en haut à droite)."
    },
    {
      "version": 6,
      "texte": "Histoires lues plus lentement, avec les lecteurs les plus calmes, et deux nouvelles ambiances pour s'endormir : un ruisseau de montagne et une nuit d'été au bord du Pacifique."
    },
    {
      "version": 5,
      "texte": "Les histoires ont maintenant un lecteur (pause, avance, retour) et changent chaque soir : 36 lectures calmes, dont deux nouvelles chaque semaine. La mer et la pluie sont en vraie stéréo."
    },
    {
      "version": 4,
      "texte": "Nouveau : « Écouter pour t'endormir ». Des histoires calmes lues par une voix humaine, ou un bruit (mer, pluie, bruit brun ou rose), qui baisse doucement puis s'arrête tout seul. Et tu peux dicter au lieu d'écrire pour vider ta tête."
    },
    {
      "version": 3,
      "texte": "Nouveau : un programme sommeil fondé sur la TCC-I, le traitement de référence de l'insomnie. Agenda de 30 secondes le matin, quatre règles, et un guide « Je ne dors pas » pour la nuit. Les sons sont maintenant de vrais enregistrements."
    },
    {
      "version": 2,
      "texte": "Souffle choisit maintenant la technique pour toi, selon l'heure, ton stress et ce qui marche le mieux sur toi. Une nouvelle technique arrive chaque semaine, et la mer suit ta respiration."
    }
